{
  "schema_version": 1,
  "repo": "owner/name",
  "pr": 89,
  "branch": "feat/example-branch",
  "base": "main",
  "source_repo": "/absolute/path/to/an/existing/clone",
  "worktree_root": "/tmp/pr-prover-worktrees",
  "state_file": "/tmp/pr-prover-owner-name-89.state.json",
  "lock_file": "/tmp/pr-prover-owner-name-89.lock",
  "visual_qa_required": false,
  "launch": {
    "identities": {
      "builder": {
        "login": "the-builder-login",
        "capabilities": ["push-branch", "comment-pr"],
        "token_env": "PR_PROVER_BUILDER_TOKEN"
      },
      "reviewer": {
        "login": "karanagent1",
        "capabilities": ["comment-pr", "review-pr"],
        "token_file": "/absolute/path/to/karanagent1.token"
      }
    }
  },
  "gates": [
    {
      "name": "tests",
      "kind": "baseline",
      "argv": ["make", "test"],
      "timeout": 900
    }
  ],
  "reviewers": [
    {
      "name": "A",
      "identity": "reviewer",
      "argv": [
        "./scripts/reviewer-lane.sh",
        "--role", "{reviewer}",
        "--repo", "{repo}",
        "--pr", "{pr}",
        "--head", "{head}",
        "--worktree", "{worktree}"
      ],
      "timeout": 1800
    },
    {
      "name": "B",
      "identity": "reviewer",
      "argv": [
        "./scripts/reviewer-lane.sh",
        "--role", "{reviewer}",
        "--repo", "{repo}",
        "--pr", "{pr}",
        "--head", "{head}",
        "--worktree", "{worktree}"
      ],
      "timeout": 1800
    }
  ],
  "builder": {
    "identity": "builder",
    "argv": [
      "./scripts/builder-lane.sh",
      "--repo", "{repo}",
      "--pr", "{pr}",
      "--branch", "{branch}",
      "--head", "{head}",
      "--attempt", "{attempt}",
      "--mode", "{mode}",
      "--blockers", "{blockers_file}",
      "--worktree", "{worktree}"
    ],
    "signature": "Fixed by: Claude Code via Hermes orchestration",
    "comment_author": "the-builder-login",
    "allowed_paths": ["src/", "tests/"],
    "timeout": 2400
  }
}
