{
  "schema_version": 2,
  "repo": "owner/name",
  "pr": 89,
  "branch": "feat/example-branch",
  "base": "main",
  "source_repo": "/absolute/path/to/an/existing/clone",
  "worktree_root": "/tmp/pr-prover-worktrees",
  "state_file": "/tmp/pr-prover-owner-name-89.state.json",
  "lock_file": "/tmp/pr-prover-owner-name-89.lock",
  "visual_qa_required": false,
  "governing_issues": [1],
  "operator_acknowledgements": [],
  "gates": [
    {
      "name": "tests",
      "kind": "baseline",
      "argv": ["make", "test"],
      "timeout": 900
    },
    {
      "name": "visual",
      "kind": "visual",
      "argv": ["./scripts/visual-qa.sh", "--head", "{head}"],
      "timeout": 900
    }
  ],
  "reviewers": [
    {
      "name": "A",
      "role": "reviewer-a",
      "argv": [
        "/absolute/path/to/pr-prover/scripts/codex-reviewer.sh",
        "--role", "{role}",
        "--repo", "{repo}",
        "--pr", "{pr}",
        "--head", "{head}",
        "--base", "{base}",
        "--worktree", "{worktree}",
        "--artifact-file", "{artifact_file}",
        "--evidence-packet", "{evidence_packet}",
        "--signature", "Reviewed by: CodexReviewer via Hermes orchestration",
        "--focus", "correctness, safety, failure behaviour, tests, and regressions"
      ],
      "artifact_author": "the-reviewer-login",
      "artifact_signature": "Reviewed by: CodexReviewer via Hermes orchestration",
      "relay": {
        "argv": [
          "gh", "pr", "comment", "{pr}",
          "--repo", "{repo}",
          "--body-file", "{artifact_file}"
        ],
        "timeout": 300
      },
      "timeout": 1800
    },
    {
      "name": "B",
      "role": "reviewer-b",
      "argv": [
        "/absolute/path/to/pr-prover/scripts/codex-reviewer.sh",
        "--role", "{role}",
        "--repo", "{repo}",
        "--pr", "{pr}",
        "--head", "{head}",
        "--base", "{base}",
        "--worktree", "{worktree}",
        "--artifact-file", "{artifact_file}",
        "--evidence-packet", "{evidence_packet}",
        "--signature", "Reviewed by: CodexReviewer via Hermes orchestration",
        "--focus", "architecture, maintainability, mission drift, and proportionality"
      ],
      "artifact_author": "the-reviewer-login",
      "artifact_signature": "Reviewed by: CodexReviewer via Hermes orchestration",
      "relay": {
        "argv": [
          "gh", "pr", "comment", "{pr}",
          "--repo", "{repo}",
          "--body-file", "{artifact_file}"
        ],
        "timeout": 300
      },
      "timeout": 1800
    },
    {
      "name": "Integration Auditor",
      "role": "integration-auditor",
      "argv": [
        "/absolute/path/to/pr-prover/scripts/codex-reviewer.sh",
        "--role", "{role}",
        "--repo", "{repo}",
        "--pr", "{pr}",
        "--head", "{head}",
        "--base", "{base}",
        "--worktree", "{worktree}",
        "--artifact-file", "{artifact_file}",
        "--evidence-packet", "{evidence_packet}",
        "--signature", "Reviewed by: CodexReviewer via Hermes orchestration",
        "--focus", "the shipped configuration, prompts, parsers, GitHub readback, and exact-head outcome as one end-to-end contract, including the Reviewer A and Reviewer B artifacts already published for this head"
      ],
      "artifact_author": "the-reviewer-login",
      "artifact_signature": "Reviewed by: CodexReviewer via Hermes orchestration",
      "relay": {
        "argv": [
          "gh", "pr", "comment", "{pr}",
          "--repo", "{repo}",
          "--body-file", "{artifact_file}"
        ],
        "timeout": 300
      },
      "timeout": 1800
    }
  ],
  "builder": {
    "argv": [
      "/absolute/path/to/pr-prover/scripts/claude-builder.sh",
      "--repo", "{repo}",
      "--pr", "{pr}",
      "--branch", "{branch}",
      "--base", "{base}",
      "--head", "{head}",
      "--attempt", "{attempt}",
      "--mode", "{mode}",
      "--blockers", "{blockers_file}",
      "--worktree", "{worktree}",
      "--signature", "Fixed by: Claude Code via Hermes orchestration",
      "--mcp-config", "/absolute/path/to/pr-prover/examples/claude-empty-mcp.json"
    ],
    "signature": "Fixed by: Claude Code via Hermes orchestration",
    "comment_author": "the-builder-login",
    "env_unset": ["GH_TOKEN"],
    "timeout": 2400
  }
}
