{
  "schema_version": 1,
  "repo": "owner/name",
  "pr": 89,
  "branch": "feat/example-branch",
  "base": "main",
  "source_repo": "/absolute/path/to/an/existing/clone",
  "worktree_root": "/tmp/pr-prover-worktrees",
  "state_file": "/tmp/pr-prover-owner-name-89.state.json",
  "lock_file": "/tmp/pr-prover-owner-name-89.lock",
  "visual_qa_required": false,
  "launch": {
    "env_allow": ["NODE_ENV"],
    "model_auth": "anthropic-api-key",
    "identities": {
      "builder": {
        "login": "the-builder-login",
        "capabilities": ["push-branch", "comment-pr"],
        "token_env": "PR_PROVER_BUILDER_TOKEN"
      },
      "reviewer": {
        "login": "karanagent1",
        "capabilities": ["comment-pr", "review-pr"],
        "token_file": "/absolute/path/to/karanagent1.token"
      }
    }
  },
  "gates": [
    {
      "name": "tests",
      "kind": "baseline",
      "argv": ["make", "test"],
      "timeout": 900
    },
    {
      "name": "visual",
      "kind": "visual",
      "argv": ["./scripts/visual-qa.sh", "--head", "{head}"],
      "timeout": 900
    }
  ],
  "reviewers": [
    {
      "name": "A",
      "identity": "reviewer",
      "agent": {
        "program": "claude",
        "model": "opus",
        "tools": ["Read", "Grep", "Glob", "Bash"]
      },
      "timeout": 1800
    },
    {
      "name": "B",
      "identity": "reviewer",
      "agent": {
        "program": "claude",
        "model": "sonnet",
        "tools": ["Read", "Grep", "Glob", "Bash"]
      },
      "timeout": 1800
    }
  ],
  "builder": {
    "identity": "builder",
    "agent": {
      "program": "claude",
      "model": "opus",
      "tools": ["Read", "Grep", "Glob", "Edit", "Write", "Bash"]
    },
    "signature": "Fixed by: Claude Code via Hermes orchestration",
    "comment_author": "the-builder-login",
    "timeout": 1500
  }
}
